{
  "name": "constellation-contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeSpec contracts and generated OpenAPI files for the Constellation platform.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('tsp-output/json-schema',{recursive:true,force:true})\" && tsp compile . --warn-as-error && node scripts/event-types.mjs",
    "format": "tsp format \"main.tsp\" \"lib/**/*.tsp\" \"services/**/*.tsp\" \"test/**/*.tsp\"",
    "lint": "node scripts/lint.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@typespec/compiler": "1.18.0",
    "@typespec/http": "1.18.0",
    "@typespec/json-schema": "1.18.0",
    "@typespec/openapi": "1.18.0",
    "@typespec/openapi3": "1.18.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
